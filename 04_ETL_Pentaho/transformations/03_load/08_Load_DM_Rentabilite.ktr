  <step>
    <name>Catégorie Rentabilité</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// Calculer rentabilite_categorie basée sur taux_marge
if (taux_marge > 0.40) { // 40%
    rentabilite_categorie = "Excellente";
} else if (taux_marge > 0.20) { // 20%
    rentabilite_categorie = "Bonne";
} else if (taux_marge > 0.10) { // 10%
    rentabilite_categorie = "Moyenne";
} else if (taux_marge >= 0) { // 0%
    rentabilite_categorie = "Faible";
} else {
    rentabilite_categorie = "Déficitaire"; // taux_marge négatif
}

// Transmettre toutes les autres variables
var fields = getInputRowMeta().getFieldNames();
for (var i = 0; i &lt; fields.length; i++) {
    var field = fields[i];
    if (field != "rentabilite_categorie") {
        this[field] = this[field];
    }
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>rentabilite_categorie</name>
        <rename>rentabilite_categorie</rename>
        <type>String</type>
        <length>20</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
