        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// Create NEW fields with cleaned values
var region_clean;
var building_clean;

// Pour region_code
if (region_code == null || !region_code.match(/^REG[0-9]{2}$/)) {
    region_clean = "NON_RENSEIGNE";
} else {
    region_clean = region_code;
}

// Pour building_code
if (building_code == null || !building_code.match(/^BAT[0-9]{3}$/)) {
    building_clean = "NON_RENSEIGNE";
} else {
    building_clean = building_code;
}

// Pour client_code
if (client_code == null || !client_code.match(/^^CLI[0-9]{3}$)) {
	client_clean = "NON_RENSEIGNE";
} else {
	client_clean = client_code;
}</jsScript_script>
      </jsScript>
    </jsScripts>
