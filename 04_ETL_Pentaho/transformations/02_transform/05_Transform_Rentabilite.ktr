    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// Function to normalize dates to yyyy-MM-dd format
function normalizeDate(dateStr) {
    if (dateStr == null || dateStr.toString().trim() === "") {
        return null;
    }
    
    var str = dateStr.toString().trim();
    
    // Remove time part if present
    if (str.indexOf(' ') > -1) {
        str = str.substring(0, str.indexOf(' '));
    }
    
    // Already yyyy-MM-dd
    if (str.match(/^\d{4}-\d{2}-\d{2}$/)) {
        return str;
    }
    
    // yyyy/MM/dd
    if (str.match(/^\d{4}\/\d{2}\/\d{2}$/)) {
        return str.replace(/\//g, '-');
    }
    
    // dd/MM/yyyy
    if (str.match(/^\d{2}\/\d{2}\/\d{4}$/)) {
        var parts = str.split('/');
        return parts[2] + '-' + parts[1] + '-' + parts[0];
    }
    
    return str; // Return as-is if pattern doesn't match
}

// Apply to all date fields
invoice_date = normalizeDate(invoice_date);
due_date = normalizeDate(due_date);
payment_date = normalizeDate(payment_date);
created_at = normalizeDate(created_at);
updated_at = normalizeDate(updated_at);
extraction_timestamp = normalizeDate(extraction_timestamp);
</jsScript_script>
      </jsScript>
    </jsScripts>
