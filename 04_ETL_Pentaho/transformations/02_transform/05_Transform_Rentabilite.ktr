  <step>
    <name>Clean Invalid Codes</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// Create NEW fields with cleaned values
var region_clean;
var building_clean;
var client_clean;

// Pour region_code
if (region_code == null || !region_code.match(/^REG[0-9]{2}$/) || parseInt(region_code.substring(3)) > 12 || parseInt(region_code.substring(3)) == 0) {
    region_clean = "NON_RENSEIGNE";
} else {
    region_clean = region_code;
}

// Pour building_code  
if (building_code == null || !building_code.match(/^BAT[0-9]{3}$/) || parseInt(building_code.substring(3)) > 500) {
    building_clean = "NON_RENSEIGNE";
} else {
    building_clean = building_code;
}

// Pour client_code
if (client_code == null || !client_code.match(/^CLI[0-9]{3}$/) || parseInt(client_code.substring(3)) > 999 || parseInt(client_code.substring(3)) == 0) {
    client_clean = "NON_RENSEIGNE";
} else {
    client_clean = client_code;
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>region_clean</name>
        <rename>region_clean</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
      <field>
        <name>building_clean</name>
        <rename>building_clean</rename>
