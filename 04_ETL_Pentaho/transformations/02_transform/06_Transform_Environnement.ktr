  <step>
    <name>Modified JavaScript value</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// Normaliser toutes les dates en yyyy-MM-dd
var dateStr = report_date.toString().trim();

if (dateStr.match(/^\d{4}-\d{2}-\d{2}$/)) {
    // Déjà bon
    report_date = dateStr;
} 
else if (dateStr.match(/^\d{4}\/\d{2}\/\d{2}$/)) {
    // 2025/01/31 → 2025-01-31
    report_date = dateStr.replace(/\//g, '-');
}
else if (dateStr.match(/^\d{2}\/\d{2}\/\d{4}$/)) {
    // 31/03/2025 → 2025-03-31
    var parts = dateStr.split('/');
    report_date = parts[2] + '-' + parts[1] + '-' + parts[0];
}</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>176</xloc>
      <yloc>368</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
