    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>reading_date</leftvalue>
        <function>REGEXP</function>
        <rightvalue/>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>^[0-9]{4}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?$</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
      </condition>
    </compare>
